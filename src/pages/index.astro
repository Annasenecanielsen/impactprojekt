---
import Layout from "../layouts/Layout.astro";
import Menu from "../components/Menu.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Menu />
  <main>
    <section class="hero">
      <img
        class="hero-billede"
        src="/images/hero.jpg"
        alt="Impact Festival"
      />
      <img
        class="hero-logo"
        src="/images/impact-logo.png"
        alt="Impact Festival logo"
      />
    </section>
    <section class="intro">
      <a class="knap" href="/program">
        PROGRAM →
      </a>
      <p>
        IMPACT FESTIVAL is rooted in<br />
        Trifolium’s existing community in<br />
        Sydhavnen, where impact is<br />
        experienced in practice.
      </p>

    </section>

    <section class="find-os">

      <div class="find-os-tekst">
        <span>F</span>
        <span>I</span>
        <span>N</span>
        <span>D</span>
		<span> </span>
        <span>O</span>
        <span>S</span>
      </div>
      <img
        class="kort"
        src="/images/kort.jpg"
        alt="Kort over Trifolium"
      />
    </section>
    <section class="trifolium">
      <a class="knap" href="#">
        TRIFOLIUM →
      </a>
    </section>
  </main>
  <Footer />
</Layout>